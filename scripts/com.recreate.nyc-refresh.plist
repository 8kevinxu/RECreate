<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily local refresh of the NYC data. See scripts/refresh-nyc-local.sh for why
  this exists (nycgovparks.org 405s GitHub's runner IPs; this machine's egress
  is not blocked, so it feeds CI a fresh cache).

  A LaunchAgent, deliberately NOT a LaunchDaemon: pushes authenticate through
  the osxkeychain credential helper, and the keychain is unlocked in the user's
  login session. A daemon runs outside that session and the push would fail.

  Install:   cp scripts/com.recreate.nyc-refresh.plist ~/Library/LaunchAgents/
             launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.recreate.nyc-refresh.plist
  Run now:   launchctl kickstart -p gui/$UID/com.recreate.nyc-refresh
  Status:    launchctl print gui/$UID/com.recreate.nyc-refresh
  Remove:    launchctl bootout gui/$UID/com.recreate.nyc-refresh
  Log:       ~/Library/Logs/recreate-nyc-refresh.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.recreate.nyc-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kevin/code/RECreate/scripts/refresh-nyc-local.sh</string>
    </array>

    <!-- TWICE daily against a 48h budget, because daily had no slack at all.
         A calendar job that runs every 24h tolerates exactly ONE failure: miss
         two in a row and the cache is 48h old the moment the second one ends.
         That is not a theoretical margin — 09-03 failed on `npm run check`,
         09-04 and 09-05 on single transient fetch timeouts, and CI went red on
         the second one. Every scrape here is best-effort against sources that
         occasionally stall, so the schedule has to assume a run will fail.
         At 12h apart, three consecutive failures still land inside the budget.

         launchd will not start a second instance while one is still running, so
         the ~10 minute scrape cannot overlap itself, and it re-fires a missed
         interval once on wake — which is what makes a laptop a viable host.
         :15 rather than a round hour to avoid piling onto everything else that
         runs on the hour. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>9</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>21</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
    </array>

    <!-- Off on purpose: this would otherwise fire a ~10 minute scrape on every
         login, and the daily schedule plus wake-catchup already covers it. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/kevin/Library/Logs/recreate-nyc-refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kevin/Library/Logs/recreate-nyc-refresh.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/kevin/code/RECreate</string>
</dict>
</plist>
