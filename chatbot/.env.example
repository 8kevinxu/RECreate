# Copy to chatbot/.env and edit. Only ANTHROPIC_API_KEY is secret, and it stays
# server-side — the app talks to this service, never to a model provider.

# Which provider answers: ollama (free, local, offline) | anthropic (hosted)
ASSISTANT_PROVIDER=ollama

# --- Ollama ------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
# Needs a model with tool support — check with: ollama show <model>
# (gemma3 has none; a 3B like llama3.2 works but under-reports.)
OLLAMA_MODEL=llama3.1:8b

# --- Anthropic ---------------------------------------------------------------
# Use a key from a DEDICATED Anthropic workspace with its own spend limit, so a
# runaway here can't reach the credits build:classes translation depends on.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Haiku by default: the facts are already retrieved in Python, so the model only
# picks a tool and writes a sentence. Swap to claude-opus-5 to test whether a
# poor answer is actually the model's fault.
ANTHROPIC_MODEL=claude-haiku-4-5
# Cost/latency lever, for models that deliberate before answering.
ANTHROPIC_EFFORT=low

# --- Limits ------------------------------------------------------------------
# Generous: on current models thinking shares this budget with the visible reply.
ASSISTANT_MAX_TOKENS=8192
# Tool round-trips per question, before the loop is cut off.
ASSISTANT_MAX_STEPS=6
ASSISTANT_TIMEOUT=120

# --- Serving -----------------------------------------------------------------
# All of this is inert on localhost and load-bearing anywhere else, because every
# answered question costs a model call.

# Shared token the app must present. Unset = no auth (the localhost default; the
# service warns about it at boot). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Then set the SAME value as EXPO_PUBLIC_ASSISTANT_TOKEN in the repo-root .env.
# Note this token ships inside the app bundle and is therefore extractable — it
# removes drive-by traffic, it does not make the endpoint private. The limits
# below are what bound the bill.
# ASSISTANT_TOKEN=

# Browser origins allowed to call this. "*" is right locally, wrong deployed.
# ASSISTANT_ALLOWED_ORIGINS=https://playrecreate.com

# Per-caller (per-IP) limits. 0 disables one.
ASSISTANT_RATE_PER_MIN=6
ASSISTANT_RATE_PER_DAY=100

# The backstop: total questions answered for everyone in any 24h window. Per-IP
# limits can't stop a distributed caller; this can. Set it to a number of
# requests you'd be content to pay for on your worst day.
ASSISTANT_DAILY_BUDGET=1000

# Set true ONLY behind a proxy that sets X-Forwarded-For (Fly, Render, nginx).
# True without one lets any caller forge a fresh IP per request.
ASSISTANT_TRUST_PROXY=false
