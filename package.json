    "seo:gsc": "node scripts/build-gsc-snapshot.js",
    "seo:report": "node scripts/seo-report.js",
    "check": "node scripts/check-app.js"
  },
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "overrides": {
    "expo-font": "~57.0.3"
  },
  "devDependencies": {
