    "build:nyc-reservations": "node scripts/build-nyc-reservations.js",
    "build:nyc-directory": "node scripts/build-nyc-directory.js",
    "build:nyc-pools": "node scripts/build-nyc-pools.js",
    "build:reservations": "node scripts/build-reservations.js",
    "build:directory": "node scripts/build-court-directory.js",
    "build:classes": "node scripts/build-classes.js",
    "build:volunteer": "node scripts/build-sf-volunteer.js",
    "build:pools": "node scripts/build-pools.js",
    "build:data:sf": "npm run build:courts && npm run build:sanbruno && npm run build:outdoor && npm run build:reservations && npm run build:directory && npm run build:classes && npm run build:volunteer && npm run build:pools",
    "build:data:nyc": "npm run build:nyc && npm run build:nyc-indoor && npm run build:nyc-reservations && npm run build:nyc-directory && npm run build:nyc-pools && npm run build:nyc-classes",
    "build:data": "npm run build:data:sf && npm run build:data:nyc",
    "update:prod": "eas update --channel production",
